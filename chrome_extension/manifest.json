{
  "manifest_version": 3,
  "name": "Atlas DownloadTube",
  "version": "3.1.0",
  "description": "إضافة Atlas DownloadTube لتحميل الفيديوهات والصوتيات مع زر التحميل واختيار الدقة لجميع المواقع",
  "permissions": ["activeTab", "downloads", "storage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:9876/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Atlas DownloadTube",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon16.png", "icon48.png", "icon128.png", "icon.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
